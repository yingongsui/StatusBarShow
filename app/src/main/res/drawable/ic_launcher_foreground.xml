<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- 满格填充 (1.55倍)，完全填满图标视口 -->
  <group
      android:scaleX="1.55"
      android:scaleY="1.55"
      android:pivotX="54"
      android:pivotY="54">

    <group
        android:scaleX="0.2109375"
        android:scaleY="0.2109375">

      <!-- 雷达背景同心圆与十字轴 -->
      <!-- r = 180 -->
      <path
          android:pathData="M256,76 A180,180 0 1,1 255.9,76 Z"
          android:strokeColor="#FFFFFF"
          android:strokeAlpha="0.04"
          android:strokeWidth="2"
          android:fillColor="#00000000" />

      <!-- r = 130 虚线圆 -->
      <path
          android:pathData="M256,126 A130,130 0 1,1 255.9,126 Z"
          android:strokeColor="#FFFFFF"
          android:strokeAlpha="0.06"
          android:strokeWidth="2"
          android:fillColor="#00000000" />

      <!-- r = 80 -->
      <path
          android:pathData="M256,176 A80,80 0 1,1 255.9,176 Z"
          android:strokeColor="#FFFFFF"
          android:strokeAlpha="0.08"
          android:strokeWidth="1.5"
          android:fillColor="#00000000" />

      <!-- 十字分割线 -->
      <path
          android:pathData="M256,56 L256,456"
          android:strokeColor="#FFFFFF"
          android:strokeAlpha="0.03"
          android:strokeWidth="1"
          android:fillColor="#00000000" />
      <path
          android:pathData="M56,256 L456,256"
          android:strokeColor="#FFFFFF"
          android:strokeAlpha="0.03"
          android:strokeWidth="1"
          android:fillColor="#00000000" />

      <!-- 扇区 1: 蓝色雷达扇区 -->
      <path
          android:pathData="M256,256 L307.2,64.7 A198,198 0 0,1 427.5,157.0 Z">
        <aapt:attr name="android:fillColor">
          <gradient
              android:type="radial"
              android:centerX="256"
              android:centerY="256"
              android:gradientRadius="210">
            <item android:offset="0.00" android:color="#FFFFFFFF" />
            <item android:offset="0.15" android:color="#F240C4FF" />
            <item android:offset="0.40" android:color="#CC00E5FF" />
            <item android:offset="0.70" android:color="#66027DFD" />
            <item android:offset="0.95" android:color="#0D01579B" />
            <item android:offset="1.00" android:color="#0001579B" />
          </gradient>
        </aapt:attr>
      </path>

      <!-- 扇区 2: 绿色雷达扇区 (旋转 100 度) -->
      <group
          android:rotation="100"
          android:pivotX="256"
          android:pivotY="256">
        <path
            android:pathData="M256,256 L307.2,64.7 A198,198 0 0,1 427.5,157.0 Z">
          <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="256"
                android:centerY="256"
                android:gradientRadius="210">
              <item android:offset="0.00" android:color="#FFFFFFFF" />
              <item android:offset="0.15" android:color="#F289FF40" />
              <item android:offset="0.40" android:color="#CC0D8B65" />
              <item android:offset="0.70" android:color="#66088D5F" />
              <item android:offset="0.95" android:color="#0D05646E" />
              <item android:offset="1.00" android:color="#00065031" />
            </gradient>
          </aapt:attr>
        </path>
      </group>

      <!-- 扇区 3: 紫色雷达扇区 (旋转 200 度) -->
      <group
          android:rotation="200"
          android:pivotX="256"
          android:pivotY="256">
        <path
            android:pathData="M256,256 L307.2,64.7 A198,198 0 0,1 427.5,157.0 Z">
          <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="256"
                android:centerY="256"
                android:gradientRadius="210">
              <item android:offset="0.00" android:color="#FFFFFFFF" />
              <item android:offset="0.15" android:color="#F2E100FF" />
              <item android:offset="0.40" android:color="#CCB713D8" />
              <item android:offset="0.70" android:color="#668D0882" />
              <item android:offset="0.95" android:color="#0D6E054E" />
              <item android:offset="1.00" android:color="#00500631" />
            </gradient>
          </aapt:attr>
        </path>
      </group>

      <!-- 环形同心圆标尺 r = 155 -->
      <path
          android:pathData="M256,101 A155,155 0 1,1 255.9,101 Z"
          android:strokeColor="#4DF6F0"
          android:strokeAlpha="0.35"
          android:strokeWidth="2"
          android:fillColor="#00000000" />

      <!-- 环形同心圆标尺 r = 105 -->
      <path
          android:pathData="M256,151 A105,105 0 1,1 255.9,151 Z"
          android:strokeColor="#F59E0B"
          android:strokeAlpha="0.45"
          android:strokeWidth="2"
          android:fillColor="#00000000" />

      <!-- 外层发光波形光晕底层 (采用最新路径: M 70,300 L 175,300 L 195,190 L 225,250 L 250,170 L 280,280 L 310,230 L 340,300 L 450,300) -->
      <path
          android:pathData="M70,300 L175,300 L195,190 L225,250 L250,170 L280,280 L310,230 L340,300 L450,300"
          android:strokeWidth="12"
          android:strokeColor="#4D93F6"
          android:strokeAlpha="0.3"
          android:strokeLineCap="round"
          android:strokeLineJoin="round"
          android:fillColor="#00000000" />

      <!-- 居中监控波形折线 (主蓝色线，颜色为最新 #4D93F6) -->
      <path
          android:pathData="M70,300 L175,300 L195,190 L225,250 L250,170 L280,280 L310,230 L340,300 L450,300"
          android:strokeWidth="6"
          android:strokeColor="#4D93F6"
          android:strokeAlpha="0.9"
          android:strokeLineCap="round"
          android:strokeLineJoin="round"
          android:fillColor="#00000000" />

      <!-- 居中监控波形折线 (高亮白线核心) -->
      <path
          android:pathData="M70,300 L175,300 L195,190 L225,250 L250,170 L280,280 L310,230 L340,300 L450,300"
          android:strokeWidth="2.5"
          android:strokeColor="#FFFFFF"
          android:strokeAlpha="0.95"
          android:strokeLineCap="round"
          android:strokeLineJoin="round"
          android:fillColor="#00000000" />

    </group>
  </group>
</vector>
